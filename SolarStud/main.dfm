  object QStatistika: TABSQuery
    CurrentVersion = '6.02 '
    DatabaseName = 'sol1'
    SessionName = 'Default'
    InMemory = False
    ReadOnly = True
    Active = True
    RequestLive = True
    SQL.Strings = (
      
        'SELECT STOKA AS STOKA1, CAST((BROI)*0.0167 AS CURRENCY)AS BROI1,' +
        ' '
      '(STOKA) AS SOLARIUM1, DATA AS DATA1, TOSTRING(DATA,"DD/M") AS '
      'WEEKDAY FROM PLASHTANIA WHERE (SOLARIUM > 0)  order by data')
    Left = 669
    Top = 672
  end
