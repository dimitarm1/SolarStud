  object DayTotal: TABSQuery
    CurrentVersion = '6.02 '
    DatabaseName = 'sol1'
    InMemory = False
    ReadOnly = True
    SQL.Strings = (
      
        'SELECT * FROM Plashtania  LEFT OUTER join STOKI ON Plashtania.ST' +
        'OKA=STOKI.STOKAKOD'
      ' WHERE DATA = :DATA_COMBO_SELECTED ORDER BY :ORDERPARAM ASC')
    Left = 164
